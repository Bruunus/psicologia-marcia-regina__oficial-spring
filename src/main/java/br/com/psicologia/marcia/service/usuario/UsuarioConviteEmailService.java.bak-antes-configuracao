package br.com.psicologia.marcia.service.usuario;

import org.springframework.beans.factory.ObjectProvider;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.mail.javamail.JavaMailSender;
import org.springframework.mail.javamail.MimeMessageHelper;
import org.springframework.stereotype.Service;
import org.springframework.web.util.UriComponentsBuilder;

import br.com.psicologia.marcia.model.ConviteUsuario;
import br.com.psicologia.marcia.model.Usuario;
import jakarta.mail.MessagingException;
import jakarta.mail.internet.MimeMessage;

@Service
public class UsuarioConviteEmailService {

    private final ObjectProvider<JavaMailSender> javaMailSenderProvider;

    @Value("${gedjadvoc.frontend.url:http://localhost:4200}")
    private String frontendUrl;

    @Value("${gedjadvoc.email.envio-real:false}")
    private boolean envioReal;

    @Value("${spring.mail.username:}")
    private String remetente;

    public UsuarioConviteEmailService(ObjectProvider<JavaMailSender> javaMailSenderProvider) {
        this.javaMailSenderProvider = javaMailSenderProvider;
    }

    public String montarLinkConvite(String token) {
        return UriComponentsBuilder
            .fromHttpUrl(frontendUrl)
            .path("/criar-senha")
            .queryParam("token", token)
            .toUriString();
    }

    public String montarLinkRedefinicaoSenha(String token) {
        return UriComponentsBuilder
            .fromHttpUrl(frontendUrl)
            .path("/redefinir-senha")
            .queryParam("token", token)
            .toUriString();
    }

    public String enviarConvite(Usuario usuario, ConviteUsuario convite) {
        String linkConvite = montarLinkConvite(convite.getToken());

        if (!envioReal) {
            imprimirConviteNoConsole(usuario, convite, linkConvite);
            return linkConvite;
        }

        JavaMailSender javaMailSender = javaMailSenderProvider.getIfAvailable();

        if (javaMailSender == null) {
            throw new IllegalStateException("servico_de_email_nao_configurado");
        }

        try {
            MimeMessage mensagem = javaMailSender.createMimeMessage();
            MimeMessageHelper helper = new MimeMessageHelper(mensagem, true, "UTF-8");

            if (remetente != null && !remetente.isBlank()) {
                helper.setFrom(remetente);
            }

            helper.setTo(usuario.getEmail());
            helper.setSubject("Convite de acesso - GEDJAdvoc");
            helper.setText(
                montarMensagemTexto(usuario, linkConvite),
                montarMensagemHtml(usuario, linkConvite)
            );

            javaMailSender.send(mensagem);

            return linkConvite;
        } catch (MessagingException e) {
            throw new IllegalStateException("erro_ao_montar_email_de_convite", e);
        }
    }

    public String enviarRedefinicaoSenha(Usuario usuario, ConviteUsuario convite) {
        String linkRedefinicao = montarLinkRedefinicaoSenha(convite.getToken());

        if (!envioReal) {
            imprimirRedefinicaoSenhaNoConsole(usuario, convite, linkRedefinicao);
            return linkRedefinicao;
        }

        JavaMailSender javaMailSender = javaMailSenderProvider.getIfAvailable();

        if (javaMailSender == null) {
            throw new IllegalStateException("servico_de_email_nao_configurado");
        }

        try {
            MimeMessage mensagem = javaMailSender.createMimeMessage();
            MimeMessageHelper helper = new MimeMessageHelper(mensagem, true, "UTF-8");

            if (remetente != null && !remetente.isBlank()) {
                helper.setFrom(remetente);
            }

            helper.setTo(usuario.getEmail());
            helper.setSubject("Redefinição de senha - GEDJAdvoc");
            helper.setText(
                montarMensagemRedefinicaoTexto(usuario, linkRedefinicao),
                montarMensagemRedefinicaoHtml(usuario, linkRedefinicao)
            );

            javaMailSender.send(mensagem);

            return linkRedefinicao;
        } catch (MessagingException e) {
            throw new IllegalStateException("erro_ao_montar_email_de_redefinicao_senha", e);
        }
    }

    private void imprimirConviteNoConsole(
        Usuario usuario,
        ConviteUsuario convite,
        String linkConvite
    ) {
        System.out.println("==============================================");
        System.out.println("CONVITE DE USUÁRIO - MODO DEV");
        System.out.println("Login: " + usuario.getLogin());
        System.out.println("E-mail: " + usuario.getEmail());
        System.out.println("Link: " + linkConvite);
        System.out.println("Expira em: " + convite.getExpiraEm());
        System.out.println("==============================================");
    }

    private void imprimirRedefinicaoSenhaNoConsole(
        Usuario usuario,
        ConviteUsuario convite,
        String linkRedefinicao
    ) {
        System.out.println("==============================================");
        System.out.println("REDEFINIÇÃO DE SENHA - MODO DEV");
        System.out.println("Login: " + usuario.getLogin());
        System.out.println("E-mail: " + usuario.getEmail());
        System.out.println("Link: " + linkRedefinicao);
        System.out.println("Expira em: " + convite.getExpiraEm());
        System.out.println("==============================================");
    }

